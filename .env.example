# Copy to .env.local and fill in from your Neon project.
#
# Neon dashboard -> your project -> "Connection string" -> Pooled connection.
# This is a server-only secret (no NEXT_PUBLIC_ prefix): it never reaches the
# browser, so it stays out of the JS bundle.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DB?sslmode=require
