# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API Keys)
#
# Use the *publishable* key (starts with sb_publishable_). It replaces the
# legacy anon JWT key, which Supabase deprecates by the end of 2026.
# It is safe to expose in client-side code — RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
